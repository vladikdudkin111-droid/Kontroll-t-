CREATE DATABASE kunstigalerii;
USE kunstigalerii;

CREATE TABLE galeriid (
	galeriid_id INT IDENTITY PRIMARY KEY,
	nimi VARCHAR(100) NOT NULL,
	aadress VARCHAR(150),
	telefon VARCHAR(30),
	email VARCHAR(100)
);

CREATE TABLE kunstnikud (
	kunstnik_id INT IDENTITY PRIMARY KEY,
	eesnimi VARCHAR(50),
	perekonnanimi VARCHAR(50),
	sunniaasta INT,
	rahvus VARCHAR(50),
	elulugu TEXT
);

CREATE TABLE teosed (
	teosed_id INT IDENTITY PRIMARY KEY,
	kunstnik_id INT,
	pealkiri VARCHAR(100),
	loomise_aasta INT,
	tehnika VARCHAR(100),
	mootmed VARCHAR(50),
	olek VARCHAR(50),
	FOREIGN KEY (kunstnik_id) REFERENCES kunstnikud(kunstnik_id)
);

CREATE TABLE naitused (
	naitus_id INT IDENTITY PRIMARY KEY,
	galerii_id INT,
	pealkiri VARCHAR(100),
	alguskuupaev DATE,
	loppkuupaev DATE,
	kuraator VARCHAR(100),
	kirjeldus TEXT,
	FOREIGN KEY (galerii_id) REFERENCES galeriid(galeriid_id)
);

CREATE TABLE naituse_teosed (
	naitus_teos_id INT IDENTITY PRIMARY KEY,
	naitus_id INT,
	teos_id INT,
	FOREIGN KEY (naitus_id) REFERENCES naitused(naitus_id),
	FOREIGN KEY (teos_id) REFERENCES teosed(teosed_id)
);

