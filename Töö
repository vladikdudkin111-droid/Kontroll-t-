CREATE PROCEDURE naita_kunstniku_teosed
    @kunstniku_id INT
AS
BEGIN
    SELECT
        k.eesnimi,
        k.perekonnanimi,
        t.pealkiri,
        t.loomise_aasta,
        t.tehnika
    FROM kunstnikud k
    JOIN teosed t
        ON k.kunstnik_id = t.kunstnik_id
    WHERE k.kunstnik_id = @kunstniku_id;
END;

EXEC naita_kunstniku_teosed 1;
DROP PROCEDURE naita_kunstniku_teosed;

SELECT
	t.pealkiri,
	k.eesnimi,
	k.perekonnanimi,
	t.loomise_aasta,
	t.tehnika
FROM teosed t
JOIN kunstnikud k ON t.kunstnik_id = k.kunstnik_id;

SELECT
	n.pealkiri AS naitus,
	g.nimi AS galerii,
	g.aadress,
	n.alguskuupaev,
	n.loppkuupaev,
	n.kuraator
FROM naitused n
JOIN galeriid g ON n.galerii_id = g.galeriid_id;

SELECT
	n.pealkiri AS Naitus,
	t.pealkiri AS Teos,
	k.eesnimi,
	k.perekonnanimi,
	g.nimi AS Galerii
FROM naituse_teosed nt
JOIN naitused n
ON nt.naitus_teos_id = n.naitus_id
JOIN teosed t
ON nt.teos_id = t.teosed_id
JOIN kunstnikud k
ON t.kunstnik_id = k.kunstnik_id
JOIN galeriid g
ON n.galerii_id = g.galeriid_id;


